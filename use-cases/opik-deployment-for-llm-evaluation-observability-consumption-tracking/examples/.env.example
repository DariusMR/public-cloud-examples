# ---- Opik ----------------------------------------------------------------
# note the /api suffix: it's the prefix the frontend's Nginx strips before
# proxying to the Java backend.
OPIK_URL_OVERRIDE=https://opik.<your-domain>/api
OPIK_PROJECT_NAME=chat-assistant
OPIK_WORKSPACE=default

# Ingress Basic Auth credentials
# required as soon as OPIK_URL_OVERRIDE goesthrough the public ingress: without them every trace send comes back 401, and the failure is silent
# omit if the application runs inside the cluster and points OPIK_URL_OVERRIDE at http://opik-frontend:5173/api
OPIK_API_USER=admin
OPIK_API_PASSWORD=<your-strong-password>

# ---- OVHcloud AI Endpoints ----------------------------------------------
OVH_AI_ENDPOINTS_API_KEY=<your-ai-endpoints-token>
OVH_AI_ENDPOINTS_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_AI_ENDPOINTS_MODEL=Qwen3.5-397B-A17B
